        </mxCell>
        <mxCell id="s10032" value="共用原有3辆运输车和1个调度放行位。设计预期：153次制造、105趟完整运输、102件合格产品；26台已联线，仍有66个独立单元待后续接入。运行、模板、Native画面分别实测后登记。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#183248;spacing=5;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="1100" width="1900" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
