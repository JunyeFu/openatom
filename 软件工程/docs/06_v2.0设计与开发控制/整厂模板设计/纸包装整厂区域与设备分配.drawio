  <diagram id="case-logistics-detail" name="09 成品输送、单箱码放与整托边界">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2020" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s12001" value="成品物流｜同一纸箱完成输送、转向与单箱码放" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=28;fontColor=#183248;spacing=5;strokeColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="25" width="1900" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s12002" value="沿用104×90×9m厂房、12区和92台设备位置；复用同布局AI三视图。三只320×240×240mm成品箱，每箱六件内装物。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#183248;spacing=5;strokeColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="1900" height="65" as="geometry" />
        </mxCell>
        <mxCell id="LOG-0" value="终检放行&lt;br&gt;3只已封箱、贴标、打带纸箱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dcebd9;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#183248;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="275" height="160" as="geometry" />
        </mxCell>
        <mxCell id="LOG-1" value="皮带输送 · Z11&lt;br&gt;原箱号、尺寸和内装物不变" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#183248;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="380" y="260" width="275" height="160" as="geometry" />
        </mxCell>
        <mxCell id="LOG-2" value="直角移载 · Z11&lt;br&gt;横移转向路径，箱体朝向保持" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#183248;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="275" height="160" as="geometry" />
        </mxCell>
        <mxCell id="LOG-3" value="辊筒输送 · Z11&lt;br&gt;原箱经过辊筒段" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#183248;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1020" y="260" width="275" height="160" as="geometry" />
        </mxCell>
        <mxCell id="LOG-4" value="真空码放 · Z11&lt;br&gt;逐箱放入固定托位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#183248;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1340" y="260" width="275" height="160" as="geometry" />
        </mxCell>
        <mxCell id="LOG-5" value="成品入库&lt;br&gt;仍按3箱验收，不冒充整托" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dcebd9;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#183248;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1660" y="260" width="275" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e12009" value="实物转运" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#247b8d;strokeWidth=2;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="LOG-0" target="LOG-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12010" value="实物转运" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#247b8d;strokeWidth=2;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="LOG-1" target="LOG-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12011" value="实物转运" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#247b8d;strokeWidth=2;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="LOG-2" target="LOG-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12012" value="实物转运" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#247b8d;strokeWidth=2;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="LOG-3" target="LOG-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12013" value="实物转运" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#247b8d;strokeWidth=2;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="LOG-4" target="LOG-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s12014" value="四台独立演示设备各1次作业，改为各处理3只真实上游箱：153 − 4 + 12 = 161次制造。原3趟直送改为5段×3趟：105 − 3 + 15 = 117趟运输。八订单仍接受102件产品。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e7cf;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#183248;spacing=5;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="1900" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s12015" value="当前实施出口&lt;br&gt;保持3箱、18件内装物身份和质量；不新增假来料，车辆按通道往返。&lt;br&gt;箱高增加120mm：真空吸头上移120mm，子支承点下移120mm，箱底轨迹不变；机架不缩放。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dcebd9;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#183248;spacing=5;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="920" height="180" as="geometry" />
        </mxCell>
        <mxCell id="s12016" value="1.5.0阶段边界 · 整托接续见第10页&lt;br&gt;1.2×0.8m托盘需明确装入箱件，原缠绕素材声明6箱、9m膜。&lt;br&gt;三次单箱码放不等于整托；第10页明确三箱装托及实际缠绕要求。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e7cf;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#183248;spacing=5;align=left;" vertex="1" parent="1">
          <mxGeometry x="1040" y="660" width="920" height="180" as="geometry" />
        </mxCell>
        <mxCell id="s12017" value="验收：Host数量、身份、内装物、完整运输、保存重开 → Native阶段与箱体尺寸 → 新精确版本模板。30台联线、62个独立单元；未达到整厂完成。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#183248;spacing=5;strokeColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="1900" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pallet-wrapping-detail" name="10 三箱装托、缠膜与整托发运">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2020" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s13001" value="整托闭环｜三箱真实装托，再缠膜发运" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=28;fontColor=#183248;spacing=5;strokeColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="25" width="1900" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s13002" value="沿用原厂房、12区与92台设备位置；同布局AI三视图继续有效。本页细化Z10人工装托与缠绕工位，接续第09页成品输送。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#183248;spacing=5;strokeColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="105" width="1900" height="75" as="geometry" />
        </mxCell>
        <mxCell id="PAL-0" value="上游成品箱 · Z11&lt;br&gt;3箱，每箱6件内装物&lt;br&gt;320×240×240mm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dcebd9;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#183248;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="430" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PAL-1" value="人工装托 · Z10&lt;br&gt;3箱＋1只空托盘 → 1托&lt;br&gt;复用人工工位与操作员" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#183248;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="545" y="250" width="430" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PAL-2" value="托盘缠绕 · Z10&lt;br&gt;1托＋9米计量膜&lt;br&gt;未缠绕 → 已缠绕" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#183248;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1030" y="250" width="430" height="160" as="geometry" />
        </mxCell>
        <mxCell id="PAL-3" value="整托发运&lt;br&gt;验收1托，内含原3箱&lt;br&gt;18件内装物身份不变" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dcebd9;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#183248;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1515" y="250" width="430" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e13007" value="3趟单箱运输" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#247b8d;strokeWidth=2;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PAL-0" target="PAL-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13008" value="1趟整托运输" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#247b8d;strokeWidth=2;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PAL-1" target="PAL-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13009" value="1趟整托运输" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#247b8d;strokeWidth=2;endArrow=block;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PAL-2" target="PAL-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s13010" value="装载几何&lt;br&gt;1200×800×120mm托盘；3箱沿长边单层排列，箱间20mm。&lt;br&gt;箱底高120mm、总高360mm；人工地面装托，不能放到小折箱台上。&lt;br&gt;实际箱件随托盘运动；移除旧示例箱，缠膜包络适配实际箱堆。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#183248;spacing=5;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="920" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s13011" value="订单与计数&lt;br&gt;原3箱发运订单改为1托订单，原3箱仍全部生产。&lt;br&gt;其余7类订单共99件保持不变；展示“99件＋1托（含3箱）”。&lt;br&gt;制造161＋1＝162次；运输117＋2＝119趟。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dcebd9;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#183248;spacing=5;align=left;" vertex="1" parent="1">
          <mxGeometry x="1040" y="480" width="920" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s13012" value="必要边界验证&lt;br&gt;少6件内装物：只能产出2箱，不得装出1托。&lt;br&gt;无空托盘：不得装托；无计量膜：不得形成已缠绕入库托盘。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e7cf;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#183248;spacing=5;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="920" height="150" as="geometry" />
        </mxCell>
        <mxCell id="s13013" value="发布门槛&lt;br&gt;Host数量、嵌套身份、耗膜、保存重开 → Native地面装托与转运&lt;br&gt;→ 普通入口创建模板、运行与重开。仅通过后发布模板1.6.0。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e7cf;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#183248;spacing=5;align=left;" vertex="1" parent="1">
          <mxGeometry x="1040" y="740" width="920" height="150" as="geometry" />
        </mxCell>
        <mxCell id="s13014" value="本页定义模板1.6.0的实现与验收要求，实际进度以原开发控制计划为准。31台联线、61个独立单元；整厂闭环及原15项缺口继续保留。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#183248;spacing=5;strokeColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="950" width="1900" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="remaining-branches-Z01" name="11 原纸准备 · 支线与配送">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="870" math="0" shadow="0">
      <root>
