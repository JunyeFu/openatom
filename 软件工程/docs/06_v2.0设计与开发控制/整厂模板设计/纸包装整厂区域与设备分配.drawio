  <diagram id="bag-line-detail" name="06 纸袋联线与物料设计">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2020" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s9001" value="纸袋联线｜明确规格、展平开袋与提手预制" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=29;fontColor=#183248;spacing=5;strokeColor=none;fontStyle=1;" vertex="1" parent="1">
