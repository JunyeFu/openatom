        </mxCell>
        <mxCell id="s9002" value="沿用同一厂房、12区与92台设备位置；本页是开发设计，运行结果另由实际Run验证。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#183248;spacing=5;strokeColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1880" height="45" as="geometry" />
        </mxCell>
        <mxCell id="BAG-raw" value="计量原纸&#10;530×240 mm&#10;3段；来料已放行" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#edf3f8;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#183248;spacing=5;" vertex="1" parent="1">
