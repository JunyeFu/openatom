          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s9027" value="共用资源：人工装箱台仍只有1台、1个工位容量、1名操作员。原装箱3次＋纸袋展平3次＋开袋3次＋提手预制3次，共12次人工台作业；必须由同一资源池排队。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#183248;spacing=5;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="970" width="1880" height="75" as="geometry" />
        </mxCell>
        <mxCell id="s9028" value="独立预期：新增24次制造、24趟运输、3只纸袋；整厂145次制造、78趟运输、33件合格成品。3辆运输车；两小时演示工作窗。纸张不因折叠而消失，运输次数不计为成品。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#899baa;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#183248;spacing=5;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="1070" width="1880" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
